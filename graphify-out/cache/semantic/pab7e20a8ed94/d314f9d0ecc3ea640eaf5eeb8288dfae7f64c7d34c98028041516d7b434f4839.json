{"nodes": [{"id": "_agents_skills_supabase_skill_supabase_skill", "label": "Supabase Agent Skill", "file_type": "document", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null}, {"id": "_agents_skills_supabase_skill_verify_against_changelog", "label": "Verify Against Supabase Changelog and Docs", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Supabase changes frequently; do not rely on training data. Fetch changelog.md and check breaking-change tags."}, {"id": "_agents_skills_supabase_skill_data_api_exposure", "label": "Exposing Tables to the Data API (explicit GRANT to anon/authenticated)", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Depending on Data API settings new tables may not be exposed; grants control table access while RLS controls rows."}, {"id": "_agents_skills_supabase_skill_rls_in_exposed_schemas", "label": "Enable RLS on Every Table in Exposed Schemas", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Tables in exposed schemas like public are reachable through the Data API; private schemas should use RLS as defense in depth."}, {"id": "_agents_skills_supabase_skill_security_checklist", "label": "Supabase Security Checklist", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null}, {"id": "_agents_skills_supabase_skill_user_metadata_unsafe", "label": "Never Use user_metadata in JWT Authorization", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "raw_user_meta_data is user-editable; store authorization data in app_metadata."}, {"id": "_agents_skills_supabase_skill_service_role_key_exposure", "label": "Never Expose service_role/Secret Key in Public Clients", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Any NEXT_PUBLIC_ env var is sent to the browser; use publishable keys in frontend code."}, {"id": "_agents_skills_supabase_skill_security_definer_bypasses_rls", "label": "SECURITY DEFINER Functions Bypass RLS", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Never add SECURITY DEFINER to fix a permission error; functions in public are callable by anon/authenticated by default. Prefer SECURITY INVOKER."}, {"id": "_agents_skills_supabase_skill_update_using_with_check", "label": "UPDATE Policies Require USING and WITH CHECK", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Without WITH CHECK a user can reassign user_id; UPDATE also needs a SELECT policy or silently affects 0 rows."}, {"id": "_agents_skills_supabase_skill_to_authenticated_bola", "label": "TO authenticated Alone Is Authentication Without Authorization (BOLA/IDOR)", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null}, {"id": "_agents_skills_supabase_skill_views_bypass_rls", "label": "Views Bypass RLS (use security_invoker)", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null}, {"id": "_agents_skills_supabase_skill_supabase_cli", "label": "Supabase CLI (discover via --help)", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null}, {"id": "_agents_skills_supabase_skill_supabase_mcp_server", "label": "Supabase MCP Server (OAuth 2.1)", "file_type": "concept", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null}, {"id": "_agents_skills_supabase_skill_schema_change_workflow", "label": "Schema Change Workflow (execute_sql, advisors, db pull)", "file_type": "rationale", "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "supabase", "contributor": null, "rationale": "Use execute_sql / supabase db query to iterate; apply_migration writes history on every call and breaks db diff/pull."}], "edges": [{"source": "_agents_skills_supabase_skill_supabase_skill", "target": "_agents_skills_supabase_skill_verify_against_changelog", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_supabase_skill_supabase_skill", "target": "_agents_skills_supabase_skill_data_api_exposure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/supabase/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_agents_skills_supabase_skill_supabase_skill", "target": "_agents_skills_supabase_skill_rls_in_expose