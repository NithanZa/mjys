{"nodes": [{"id": "_devin_skills_line_liff_skill_line_liff_skill", "label": "LINE LIFF / LINE MINI App Skill for Next.js", "file_type": "document", "source_file": ".devin/skills/line-liff/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_devin_skills_line_liff_skill_liff_client_side_rule", "label": "LIFF Is Client-Side Only in Next.js", "file_type": "rationale", "source_file": ".devin/skills/line-liff/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LIFF SDK must run in 'use client' components after liff.init(); calling it in Server Components or SSR causes window-is-not-defined errors."}, {"id": "_devin_skills_line_liff_skill_initliff", "label": "initLiff() Singleton Helper", "file_type": "code", "source_file": ".devin/skills/line-liff/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Memoizes a single liff.init() promise via dynamic import to prevent duplicate initialization and SSR import problems."}, {"id": "_devin_skills_line_liff_skill_liffprovider", "label": "LiffProvider / useLiff Context", "file_type": "code", "source_file": ".devin/skills/line-liff/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_devin_skills_line_liff_skill_public_vs_private_env_vars", "label": "NEXT_PUBLIC_LIFF_ID Public vs Server-Only LINE Secrets", "file_type": "rationale", "source_file": ".devin/skills/line-liff/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LIFF ID is safe to expose; channel secret and access token must never use the NEXT_PUBLIC_ prefix or they leak into the browser bundle."}, {"id": "_devin_skills_line_liff_skill_messaging_api_separation", "label": "Messaging API Backend Separation", "f