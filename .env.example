# Database (Supabase)
# DATABASE_URL: Transaction pooler connection string (port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: Direct database connection string (port 5432) for migrations
DIRECT_URL="postgresql://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Storage Integration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Secret key (sb_secret_...) from Settings > API Keys > "Publishable and secret API keys".
# Server-only — never expose this to the browser. Falls back to the legacy
# SUPABASE_SERVICE_ROLE_KEY if SUPABASE_SECRET_KEY is unset (see lib/supabase.ts).
SUPABASE_SECRET_KEY="sb_secret_your-supabase-secret-key-here"

# LINE Integration (LIFF & Login)
# Required when NEXT_PUBLIC_STANDALONE_MODE is not true.
# LIFF channel scopes must include openid (for ID tokens) and profile.
NEXT_PUBLIC_LIFF_ID="your-liff-id-here"
# Must be the LINE Login channel ID that owns the LIFF app (not a Messaging API channel).
LINE_LOGIN_CHANNEL_ID="your-line-login-channel-id-here"

# Security (QR member-pass signing)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET="your-32-byte-hex-signing-secret-here"

# Standalone email/password web app. Set true only for local/web-without-LINE.
# Production LINE LIFF: leave this false or unset, then rebuild.
NEXT_PUBLIC_STANDALONE_MODE=false

# Base URL used to build email confirmation / password reset links
# (falls back to the request origin if not set).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Confirmation / reset emails: the built-in Supabase mailer only delivers to
# organization members. Add custom SMTP (Authentication > SMTP) for other addresses.

# Admin Passphrase (Security Option A)
ADMIN_PASSPHRASE="your-studio-passphrase-here"

# Rate limiting (Upstash Redis) — protects login/register/password-reset routes.
# Create a free database at https://console.upstash.com and copy the REST credentials.
# If left unset, rate limiting is disabled (fails open) — fine for local dev only.
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token-here"
